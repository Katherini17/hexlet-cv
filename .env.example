# === JWT-ключи (RSA) — пути к файлам ===
# Для prod: Render Secret Files монтируются в /etc/secrets/
RSA_PRIVATE_KEY_PATH=/etc/secrets/private.pem
RSA_PUBLIC_KEY_PATH=/etc/secrets/public.pem

# === База данных (prod) ===
JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/hexlet_cv
USERNAME=hexlet
PASSWORD=

# === Интеграции (задел на будущее, в коде пока нет) ===
HH_API_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=